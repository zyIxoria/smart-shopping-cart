# Địa chỉ Backend (để trống = cùng origin, Backend phục vụ luôn frontend/dist).
# Ví dụ khi chạy dev riêng:  VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
# true = chạy bằng dữ liệu giả (không cần Backend). Có thể bật nhanh bằng ?mock=1 trên URL.
VITE_USE_MOCK=false
# WebSocket realtime. Để trống = ws://<host của API>:8081/ws
VITE_WS_URL=
# API điều khiển Simulator cho trang /simulator. Để trống = http://<host trang>:8090 (hoặc dùng ?sim=URL)
VITE_SIM_URL=
