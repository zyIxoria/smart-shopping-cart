# ===== Backend & Database =====
API_HOST=0.0.0.0
API_PORT=8000
WS_PORT=8000                       # Cổng WebSocket (tích hợp trực tiếp vào FastAPI cổng 8000)
CORS_ORIGINS=*                    # production: liệt kê origin cụ thể, cách nhau bằng dấu phẩy

# Cơ sở dữ liệu: 'postgres' (cho Docker / Production) hoặc 'sqlite' (cho DEV cục bộ nhanh)
DB_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartcart
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartcart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PATH=./data/smartcart.db       # Dùng khi DB_BACKEND=sqlite
SEED_ON_START=1
LOG_LEVEL=INFO

# ===== MQTT =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_ENABLED=1
# Chỉ khi dùng broker CÔNG CỘNG (vd. mô phỏng Wokwi) – xem firmware/README.md. Phải duy nhất/riêng của bạn:
# MQTT_TOPIC_ROOT=smartcart-abc123xyz
# MQTT_CLIENT_ID=backend-abc123xyz

# ===== Đăng nhập Admin/API (xem docs/SECURITY.md) =====
AUTH_ENABLED=1                  # 0 = tắt hoàn toàn đăng nhập (CHỈ để dev/demo cục bộ)
ADMIN_USERNAME=admin
# Không đặt ADMIN_PASSWORD => Backend sinh mật khẩu ngẫu nhiên và in ra log mỗi lần chạy.
# ADMIN_PASSWORD=
# Hoặc đưa hash PBKDF2 thay mật khẩu thô:  python -c "from shared.security import hash_password; print(hash_password('mat-khau'))"
# ADMIN_PASSWORD_HASH=
# Tài khoản chỉ xem (tuỳ chọn):
# VIEWER_USERNAME=viewer
# VIEWER_PASSWORD=
# Khoá ký token. Đặt cố định (>= 32 ký tự ngẫu nhiên) nếu muốn token sống qua lần khởi động lại.
# TOKEN_SECRET=
ADMIN_TOKEN_TTL_S=28800         # 8 giờ
SESSION_TOKEN_TTL_S=14400       # 4 giờ (token của khách)
LOGIN_MAX_ATTEMPTS=5            # sai quá số lần này => khoá tạm cặp (IP, user)
LOGIN_LOCKOUT_S=60

# ===== MQTT bảo mật (sinh tự động bởi: python -m tools.provision -> secrets/secure.env) =====
# MQTT_USERNAME=backend
# MQTT_PASSWORD=
# MQTT_TLS=1                    # cổng TLS thường là 8883
# MQTT_CA_FILE=./secrets/tls/ca.crt
# MQTT_TLS_INSECURE=0           # 1 = KHÔNG kiểm tra chứng chỉ (chỉ để thử)
# Ký message HMAC. Có khoá này => mặc định BẮT BUỘC ký; REQUIRE_SIGNATURE=0 = cho phép xe cũ chưa ký (chuyển đổi).
# DEVICE_MASTER_KEY=            # 64 ký tự hex; KHÔNG đưa vào firmware (firmware chỉ giữ khoá riêng của xe)
# REQUIRE_SIGNATURE=1

# ===== Ngưỡng cảnh báo =====
BATTERY_LOW_PERCENT=20          # pin < 20 %  -> LOW_BATTERY
WEIGHT_TOLERANCE_G=100          # |thực tế - dự kiến| > 100 g -> WEIGHT_MISMATCH
HEARTBEAT_TIMEOUT_S=15          # > 15 s không có tin -> OFFLINE
MONITOR_INTERVAL_S=2
MAX_CLOCK_SKEW_S=300            # loại message lệch giờ quá 5 phút (0 = tắt)
COMMAND_ACK_TIMEOUT_S=5

# ===== Simulator =====
SIM_CARTS=3
SIM_HEARTBEAT_S=5
SIM_TELEMETRY_S=10
SIM_BATTERY_START=100
SIM_BATTERY_DRAIN_PER_MIN=0.2
SIM_NOISE_G=3
SIM_CONTROL_PORT=8090
SIM_CONTROL_HOST=127.0.0.1        # 127.0.0.1 an toàn cục bộ; 0.0.0.0 cho Docker
# SIM_CONTROL_TOKEN=               # Tuỳ chọn: đặt token bảo vệ API điều khiển Simulator (:8090)
OFFLINE_QUEUE_MAX_SIZE=50         # Số lượng sự kiện quét tối đa lưu đệm khi xe mất mạng
